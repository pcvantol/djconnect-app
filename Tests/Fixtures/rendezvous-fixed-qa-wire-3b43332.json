      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{342}\\.[A-Za-z0-9_-]{16}\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{22}$"
